# Required for /ask. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model. Run "python scripts/list_gemini_models.py" to see the models your key can use.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2

# Optional. Only needed if Hugging Face rate-limits the model download.
HF_TOKEN=

# Optional tuning (these are the defaults)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
MAX_UPLOAD_MB=20
